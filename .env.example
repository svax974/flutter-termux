# Ne pas « sourcer » ce fichier : il est lu comme des données par Python.
# local = Linux natif, docker = Linux x86-64 en conteneur, ssh = serveur Linux.
# Sur macOS, local choisit automatiquement docker.
BUILD_TARGET=local

# Un alias de ~/.ssh/config convient (ProxyJump et agent SSH sont conservés).
SSH_HOST=mon-serveur-build
SSH_USER=
SSH_PORT=22
SSH_IDENTITY_FILE=

# Sur la machine qui compile. Un dossier distinct est créé pour chaque version.
WORK_DIR=~/.cache/flutter-termux
# Seuil de démarrage conservateur, en Gio LIBRES ; arrêt avant téléchargement.
MIN_FREE_GIB=150
# Réserve surveillée pendant les commandes longues (arrêt contrôlé).
DISK_RESERVE_GIB=10
# 1 par défaut : évite les OOM constatés sur VPS de 8 Gio RAM.
JOBS=1

# Dépôt des adaptations Bionic, distinct des sources officielles Flutter.
# Remplacer par son fork si une nouvelle version exige de rebaser les correctifs.
BACKEND_REPO=https://github.com/GeneralKaos666/flutter-for-termux.git
BACKEND_REF=main

# Facultatif : réutiliser un SDK / NDK déjà installé SUR LA CIBLE.
# Les chemins ne sont pas des chemins du Mac quand BUILD_TARGET=ssh/docker.
ANDROID_SDK_ROOT=
ANDROID_NDK=
# Facultatif : version du NDK officiel hôte, sinon [ndk].version du backend.
# Si cette référence n'existe pas chez Google, arrêt avec une erreur explicite.
NDK_VERSION=
# Automatiser les prérequis sans supprimer le choix interactif de version.
AUTO_INSTALL=false
# true vaut acceptation des licences Android pour les installations du lanceur.
ACCEPT_ANDROID_LICENSES=false

# Docker : sources dans un volume Linux, paquets exportés dans ce dossier local.
DOCKER_IMAGE=flutter-termux-builder:ubuntu24.04
DOCKER_VOLUME=flutter-termux-build
# Vide = contexte actif s'il utilise un socket Unix local.
# Exemples : desktop-linux, colima, default (voir docker context ls).
DOCKER_CONTEXT=
ARTIFACT_DIR=./artifacts
